# The installer (install.sh / install.bat) creates app/.env with these settings and fresh secrets. To configure by
# hand, copy this file to app/.env and fill it in. Never commit app/.env.
# `npm run start:selfhost` (and the installers' service or Scheduled Task) puts app/.env into the environment; a
# variable already set in the shell wins. Next.js would read .env.local after that, so it could only add keys
# app/.env lacks, never change one; at build time (npm run build) .env.local wins for NEXT_PUBLIC_* values instead.
# Don't use .env.local for a self-hosted install: keep every setting in app/.env.

# Runtime mode. selfhost = one machine, local database, built-in scheduler (the default of this edition).
# (cloud is the Vercel + Supabase deployment, demo is a read-only sandbox.)
WATCHBELL_MODE=selfhost
# Local PGlite database. Leave as is for a self-hosted install.
DATABASE_URL=pglite:
# Folder for the PGlite database files (default ./data). Back this folder up.
WATCHBELL_DATA_DIR=./data

# Required. Encrypts the provider tokens and keys you save in the console. Generate once and keep it safe:
# losing it makes the saved tokens unreadable.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
OPS_ENCRYPTION_KEY=
# The address you open Watchbell at (used for links in alerts and as the OAuth redirect base).
SITE_URL=http://localhost:3100

# Required. Scheduler secrets: the console calls its own /api/daily with CRON_SECRET (the "re-run daily job"
# auto-action), and an external cron or script that triggers /api/collect or /api/daily authenticates with them.
# Without them those routes and that action stay off ("The scheduler settings are missing").
# COLLECTOR_SECRET needs at least 32 characters, CRON_SECRET at least 16. Generate each (43 characters) with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
COLLECTOR_SECRET=
CRON_SECRET=

# Optional. Number of reverse proxies in front of Watchbell whose X-Forwarded-For entry can be trusted
# (rate limiting uses the client address). Leave unset when it is not behind a proxy.
# WATCHBELL_TRUSTED_PROXY_HOPS=1
# Optional. Folder holding the database migrations when you start the server from outside app/ (default drizzle-selfhost).
# WATCHBELL_MIGRATIONS_DIR=drizzle-selfhost
# Optional. Set to 1 only if you really want selfhost mode against a remote Postgres DATABASE_URL.
# WATCHBELL_ALLOW_REMOTE_DB=1
# Optional. Interface and port for `npm run start:selfhost` (default 127.0.0.1 and 3100).
# HOST=127.0.0.1
# PORT=3100
# Optional. The time zone of every time Watchbell shows and sends, of the daily job (03:00) and of the email digest
# (07:00): an IANA name such as Europe/Berlin or America/New_York. Unset means Asia/Jakarta (WIB). The installers and
# the npm CLI write this computer's zone into a new app/.env. See docs/configuration.md, "Time zone".
# WATCHBELL_TIMEZONE=Europe/Berlin

# Notifications (all optional: a missing one turns that channel off, nothing else breaks).
# Telegram: create a bot with @BotFather. The chat is chosen in Alerts > Notifications.
TELEGRAM_BOT_TOKEN=
# Resend sending-only API key and the From address of the daily digest, for example: Watchbell <noreply@your-domain>
RESEND_API_KEY=
DIGEST_FROM=

# Heartbeat of Watchbell's own daily job (optional). The ping token of a heartbeat you add on the console's own app
# (period 1 day, grace 6 h), shown once when you add it: the daily job then pings it itself.
DAILY_HEARTBEAT_TOKEN=

# Backups to Google Drive (optional: without them the Backups page says what to set).
# Google Cloud > APIs & Services > Credentials > OAuth client ID (Web application), scope drive.file only.
# Authorized redirect URI: <SITE_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Cloud mode (optional) -------------------------------------------------------------------------------------------
# Only for WATCHBELL_MODE=cloud (Vercel + Supabase). A self-hosted install leaves all of these empty.
# Supabase > Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# The first owner's email (cloud mode creates the owner with `npm run bootstrap:owner`).
OWNER_EMAIL=
# Cloudflare Turnstile site key (public) for the sign-in bot check.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Upstash > QStash > Signing keys (the hosted scheduler; a self-hosted install uses the built-in one)
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
