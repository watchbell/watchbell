{
  "name": "watchbell",
  "version": "1.2.3",
  "private": true,
  "scripts": {
    "dev": "cross-env NEXT_TELEMETRY_DISABLED=1 next dev --port 3100",
    "build": "cross-env NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "cross-env NEXT_TELEMETRY_DISABLED=1 next start --port 3100",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cli": "node --test \"bin/*.test.mjs\"",
    "db:generate": "drizzle-kit generate",
    "db:generate:selfhost": "drizzle-kit generate --config drizzle.selfhost.config.ts",
    "start:selfhost": "node scripts/start-selfhost.mjs",
    "stop:selfhost": "node scripts/stop-selfhost.mjs",
    "bootstrap:owner": "node --env-file-if-exists=.env.local scripts/bootstrap-owner.mts",
    "reset-login": "node scripts/reset-login.mts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@electric-sql/pglite": "^0.5.8",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "@tabler/icons-react": "^3.49.0",
    "@upstash/qstash": "^2.12.0",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.55.0",
    "next": "16.4.2",
    "postgres": "^3.4.9",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^7.0.3",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.2",
    "msw": "^3.0.3",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    }
  }
}
